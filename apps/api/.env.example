# Copy to apps/api/.env — dev-only values, never reuse real passwords here.
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
# Where PGlite stores its files (gitignored). Delete with `pnpm db:reset`.
DATA_DIR=.data/politico
JWT_SECRET=dev-only-change-me-politico-jwt-secret
# Seeded on first boot when the database is empty.
SEED_ADMIN_EMAIL=admin@politico.test
SEED_ADMIN_PASSWORD=politico-admin-dev
SEED_VOTER_EMAIL=voter@politico.test
SEED_VOTER_PASSWORD=politico-voter-dev
